{
  "expo": {
    "name": "Pulse",
    "slug": "pulse",
    "scheme": "pulse",
    "version": "0.1.4",
    "orientation": "portrait",
    "icon": "./assets/icon-1024.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "net.eresea.roots.pulse",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-foreground.png",
        "backgroundColor": "#0f172a"
      },
      "permissions": ["POST_NOTIFICATIONS", "VIBRATE"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-updates",
      [
        "expo-notifications",
        {
          "color": "#2dd4bf",
          "defaultChannel": "roots-events"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "roots": {
        "apiBaseUrl": "https://nexus.eresea.net",
        "updateChannel": "production",
        "pollingIntervalMs": 30000
      }
    }
  }
}
